from flask import Flask, jsonify
from meter_simulator import meter

app = Flask(__name__)

@app.route('/')
def home():
    return "KPLC Tracker Web Service active."

@app.route('/trigger-sms', methods=['GET'])
def trigger_sms():
    simulation_status = meter.simulate_consumption()
    return jsonify({"status": "OK"}), 200

if __name__ == '__main__':
    app.run(debug=True)